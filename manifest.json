{
  "manifest_version": 3,
  "name": "Egodact Addon: Chat",
  "version": "1.3.1",
  "description": "Chat and group chats with your Egodact classmates, right from the top bar.",
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://app.egodact.com/*"
      ],
      "js": [
        "vendor/firebase-app-compat.js",
        "vendor/firebase-auth-compat.js",
        "vendor/firebase-firestore-compat.js",
        "vendor/firebase-storage-compat.js",
        "sdk.js",
        "lib.js",
        "config.js",
        "js/store.js",
        "js/identity.js",
        "js/directory.js",
        "js/blobstore.js",
        "js/transport.js",
        "js/emoji-data.js",
        "js/ui.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "permissions": [
    "declarativeNetRequest"
  ],
  "host_permissions": [
    "https://api.egodact.com/*",
    "https://app.egodact.com/*"
  ],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "csp_media",
        "enabled": true,
        "path": "rules/csp_media.json"
      }
    ]
  }
}