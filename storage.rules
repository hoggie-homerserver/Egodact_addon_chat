rules_version = '2';

// Egodact Chat — Firebase Storage rules (1.3.0)
// Paste in Firebase console -> Storage -> Rules -> Publish.
// Also enable Storage in the project first.

service firebase.storage {
  match /b/{bucket}/o {
    // chat/{roomId}/{uploadId}/{fileName}
    match /chat/{roomId}/{uploadId}/{fileName} {
      allow read: if request.auth != null;

      allow write: if request.auth != null
        && request.resource.size <= 25 * 1024 * 1024
        && request.resource.metadata.uid == request.auth.uid;

      allow delete: if request.auth != null
        && resource.metadata.uid == request.auth.uid;
    }
  }
}
