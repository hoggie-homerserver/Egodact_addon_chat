rules_version = '2';

// Egodact Chat — Firestore rules
// Paste this in Firebase console -> Firestore Database -> Rules -> Publish.
//
// The Firebase web config is baked into the extension and is public
// by nature (anyone can read it from the bundle). These rules are
// therefore the real gate: they require an anonymous session and
// reject malformed or oversized writes.
//
// They intentionally do not verify room membership, because
// membership uses Egodact user ids while Firebase auth uses
// anonymous uids. Treat this as a school-project baseline, not a
// hardened production backend.
//
// Message ownership works through `senderUid`: the client that wrote
// the message stores its Firebase uid in that field, and only that
// uid may edit the text or delete the message. Reactions are a
// `reactions` map that any signed-in client may toggle, because the
// reacting user is identified by Egodact id and not by the Firebase
// session.

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function validRoom(data) {
      return data.keys().hasAll(['type', 'members', 'createdAt'])
        && data.type in ['dm', 'group']
        && data.members is list
        && data.members.size() >= 2
        && data.members.size() <= 100
        && data.createdAt is timestamp
        && (!data.keys().hasAny(['name']) || (data.name is string && data.name.size() <= 120))
        && (!data.keys().hasAny(['lastMessage']) || (data.lastMessage is string && data.lastMessage.size() <= 200));
    }

    function validMessage(data) {
      return data.keys().hasAll(['text', 'senderId', 'senderName', 'createdAt'])
        && data.text is string
        && data.text.size() > 0
        && data.text.size() <= 2000
        && data.senderId is string
        && data.senderId.size() > 0
        && data.senderId.size() <= 128
        && data.senderName is string
        && data.senderName.size() <= 80
        && data.createdAt is timestamp
        && (!data.keys().hasAny(['senderPhoto']) || (data.senderPhoto is string && data.senderPhoto.size() <= 2000))
        && (!data.keys().hasAny(['senderUid']) || (data.senderUid is string && data.senderUid.size() <= 128))
        && (!data.keys().hasAny(['reactions']) || data.reactions is map)
        && (!data.keys().hasAny(['editedAt']) || data.editedAt is timestamp);
    }

    function isSender() {
      return signedIn() && request.auth.uid == resource.data.get('senderUid', '');
    }

    function editedTextIsValid() {
      return request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 2000;
    }

    match /rooms/{roomId} {
      allow read: if signedIn();
      allow create: if signedIn() && validRoom(request.resource.data);
      allow update: if signedIn() && validRoom(request.resource.data);
      allow delete: if false;

      match /messages/{messageId} {
        allow read: if signedIn();
        allow create: if signedIn() && validMessage(request.resource.data);

        // Two allowed updates:
        //   1. toggling reactions (any signed-in client);
        //   2. editing the text, only by the client that wrote it.
        allow update: if signedIn() && (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reactions'])
          || (isSender()
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text', 'editedAt', 'reactions'])
            && editedTextIsValid())
        );

        allow delete: if isSender();
      }
    }
  }
}
