rules_version = '2';

// Egodact Chat — Firestore rules
// Paste this in Firebase console -> Firestore Database -> Rules -> Publish.
//
// These rules require an authenticated (anonymous) session so the
// database is not open to the whole internet. They intentionally do
// not verify room membership, because membership uses Egodact user
// ids while Firebase auth uses anonymous uids. Treat this as a
// school-project baseline, not a hardened production backend.

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    match /rooms/{roomId} {
      allow read: if signedIn();
      allow create: if signedIn();
      allow update: if signedIn();

      match /messages/{messageId} {
        allow read: if signedIn();
        allow create: if signedIn();
      }
    }
  }
}
